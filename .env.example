# Postgres connection. Railway injects DATABASE_URL automatically for its Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crip

# Signs the session cookie (HMAC-SHA256). At least 16 characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production: without it a public development fallback is used.
SESSION_SECRET=
