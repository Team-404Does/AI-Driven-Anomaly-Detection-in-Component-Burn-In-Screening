# Copy to .env for local dev, or paste values into Vercel:
#   Project → Settings → Environment Variables
# Required — Postgres connection string (hosted: Railway/Supabase/Neon public URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Optional — max Postgres pool connections per serverless instance (default 5)
# PGPOOL_MAX=5
